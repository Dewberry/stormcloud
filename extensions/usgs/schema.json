
  {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/dewberry/stormcloud/refs/heads/feature/gages/extensions/sgage/schema.json#",
    "title": "sgage NWIS Extension",
    "description": "STAC extension for sgage NWIS gage data, supporting hydrologic and geographic attributes.",
    "oneOf": [
      {
        "$comment": "This is the schema for STAC Items.",
        "allOf": [
          {
            "$ref": "#/definitions/stac_extensions"
          },
          {
            "type": "object",
            "required": ["type", "properties", "assets"],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "properties": {
                "$ref": "#/definitions/fields"
              },
              "assets": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/fields"
                }
              }
            }
          }
        ]
      },
      {
        "$comment": "This is the schema for STAC Collections.",
        "allOf": [
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "const": "Collection"
              },
              "assets": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/fields"
                }
              },
              "item_assets": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/fields"
                }
              }
            }
          },
          {
            "$ref": "#/definitions/stac_extensions"
          }
        ]
      }
    ],
    "definitions": {
      "stac_extensions": {
        "type": "object",
        "required": ["stac_extensions"],
        "properties": {
          "stac_extensions": {
            "type": "array",
            "contains": {
              "const": "https://raw.githubusercontent.com/dewberry/stormcloud/refs/heads/feature/gages/extensions/sgage/schema.json"
            }
          }
        }
      },
      "fields": {
        "$comment": "Nomenclature based on sgage data retrieval.",
        "type": "object",
        "properties": {
          "sgage:gage_number": {
            "type": "string",
            "description": "Unique identifier for the sgage gage station."
          },
          "sgage:gage_name": {
            "type": "string",
            "description": "Name of the sgage gage station."
          },
          "sgage:state": {
            "type": "string",
            "description": "State where the gage is located."
          },
          "sgage:huc": {
            "type": "string",
            "description": "Hydrologic Unit Code for the watershed."
          },
          "sgage:drainage_area": {
            "type": "number",
            "description": "Drainage area in square miles."
          },
          "sgage:altitude": {
            "type": "number",
            "description": "Altitude of the gage station in feet."
          },
          "sgage:vertical_datum": {
            "type": "string",
            "description": "Vertical datum reference (e.g., NAVD88)."
          },
          "sgage:time_zone": {
            "type": "string",
            "description": "Time zone of the gage station (e.g., MST)."
          },
          "sgage:peaks:start": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Start date for peak flow data."
          },
          "sgage:peaks:end": {
            "type": ["string", "null"],
            "format": "date",
            "description": "End date for peak flow data."
          }
        },
        "additionalProperties": false
      }
    }
  }
  